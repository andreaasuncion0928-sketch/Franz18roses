<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0, maximum-scale=1.0, user-scalable=no">
    <title>Franz — Eighteen</title>
    <link href="https://fonts.googleapis.com/css2?family=Alex+Brush&family=Montserrat:wght@300;400;500;600&family=Playfair+Display:ital,wght@0,400;0,600;1,400&display=swap" rel="stylesheet">
    <style>
        :root {
            --lavender: #ab85b8;
            --charcoal: #2C2C2C;
            --white: #FFFFFF;
            --light-lavender: #cbb6d4;
        }

        * { margin: 0; padding: 0; box-sizing: border-box; }

        body {
            font-family: 'Montserrat', sans-serif;
            background-color: var(--charcoal);
            color: var(--white);
            overflow: hidden; 
            position: fixed;
            width: 100%;
            height: 100%;
        }

        /* Cinematic Vintage Film Grain */
        .grain {
            position: fixed; top: 0; left: 0; width: 100%; height: 100%;
            background-image: url("data:image/svg+xml,%3Csvg viewBox='0 0 200 200' xmlns='http://www.w3.org/2000/svg'%3E%3Cfilter id='noiseFilter'%3E%3CfeTurbulence type='fractalNoise' baseFrequency='0.85' numOctaves='3' stitchTiles='stitch'/%3E%3C/filter%3E%3Crect width='100%25' height='100%25' filter='url(%23noiseFilter)' opacity='0.08'/%3E%3C/svg%3E");
            z-index: 999; pointer-events: none;
        }

        /* Typography */
        .serif { font-family: 'Playfair Display', serif; font-weight: 400; }
        .script { font-family: 'Alex Brush', cursive; font-size: clamp(3.5rem, 12vw, 4.5rem); line-height: 1; }
        .sans { font-family: 'Montserrat', sans-serif; font-weight: 300; }
        .huge { font-size: clamp(3.5rem, 14vw, 6rem); line-height: 1; letter-spacing: -0.02em; }
        .label { font-size: 0.75rem; text-transform: uppercase; letter-spacing: 0.2em; color: var(--light-lavender); margin-bottom: 1.5rem; font-weight: 500; }

        /* Screen Layout - Optimized for Mobile */
        .screen {
            position: absolute; top: 0; left: 0; 
            width: 100vw; 
            height: 100vh; 
            height: 100dvh; 
            display: flex; flex-direction: column; justify-content: center; align-items: center;
            opacity: 0; visibility: hidden; transition: opacity 0.8s ease, visibility 0.8s ease;
            text-align: center; overflow-y: auto; padding: 2rem 1.2rem;
            -webkit-overflow-scrolling: touch;
        }
        .screen.active { opacity: 1; visibility: visible; z-index: 10; }
        .content-wrap { max-width: 500px; width: 100%; margin: auto; z-index: 1; position: relative; }

        /* Transparent Content Boxes - 20% Opacity (Highly See-Through) */
        .content-box-light, .content-box-dark {
            background: rgba(255, 255, 255, 0.2); 
            padding: 3rem 1.5rem;
            border-radius: 16px;
            box-shadow: 0 10px 40px rgba(0,0,0,0.3);
            color: var(--white);
            backdrop-filter: blur(4px); 
            -webkit-backdrop-filter: blur(4px);
        }

        /* BACKGROUND IMAGES SETUP */
        .bg-layer {
            position: fixed; top: 0; left: 0; 
            width: 100vw; 
            height: 100vh; 
            height: 100dvh; 
            background-size: cover;
            background-position: center;
            background-repeat: no-repeat;
            background-image: url('explorethevening.jpg');
            z-index: -2;
            transform: scale(1);
            transition: transform 10s ease-out;
        }
        .screen.active .bg-layer { transform: scale(1.08); } 

        /* OVERLAYS */
        .cover-overlay { position: fixed; top: 0; left: 0; width: 100%; height: 100%; background: radial-gradient(circle, transparent 20%, rgba(0,0,0,0.5) 100%); z-index: -1; pointer-events: none; }
        .overlay-60 { position: fixed; top: 0; left: 0; width: 100%; height: 100%; background: rgba(0, 0, 0, 0.6); z-index: -1; pointer-events: none; }

        /* Elegant Buttons */
        .btn-glass {
            display: inline-block; margin-top: 1.5rem; padding: 12px 28px;
            border: 1px solid rgba(255, 255, 255, 0.5); border-radius: 50px;
            background: rgba(255, 255, 255, 0.15); backdrop-filter: blur(8px); -webkit-backdrop-filter: blur(8px);
            color: var(--white); font-family: 'Montserrat', sans-serif;
            text-transform: uppercase; letter-spacing: 0.15em; font-size: 0.7rem; font-weight: 500;
            text-decoration: none; cursor: pointer; transition: all 0.3s ease;
        }
        .btn-glass:hover { background: rgba(255, 255, 255, 0.3); border-color: var(--white); }
        .btn-colored { border-color: var(--light-lavender); color: var(--white); background: rgba(171, 133, 184, 0.4); }
        .btn-colored:hover { background: rgba(171, 133, 184, 0.7); }

        /* Music Button Specific Tweaks */
        .btn-music { padding: 8px 20px; font-size: 0.6rem; text-transform: none; letter-spacing: 0.1em; margin-top: 1rem; border-color: rgba(255,255,255,0.3); }

        /* Menu Elements */
        .menu-list { display: flex; flex-direction: column; gap: 1.2rem; margin-top: 1.5rem; }
        .menu-item { cursor: pointer; background: none; border: none; font-family: 'Playfair Display', serif; font-size: 1.3rem; color: var(--white); }
        .menu-item:hover { color: var(--light-lavender); }
        .menu-sub { display: block; font-family: 'Montserrat', sans-serif; font-size: 0.55rem; text-transform: uppercase; letter-spacing: 0.1em; color: var(--light-lavender); margin-top: 0.3rem; font-weight: 500; }

        /* Back Button */
        .back-btn { position: fixed; top: 1rem; left: 50%; transform: translateX(-50%); background: rgba(255,255,255,0.2); border: 1px solid rgba(255,255,255,0.3); cursor: pointer; font-size: 0.6rem; letter-spacing: 0.15em; text-transform: uppercase; font-family: 'Montserrat', sans-serif; font-weight: 500; color: var(--white); padding: 8px 16px; border-radius: 20px; z-index: 50; backdrop-filter: blur(5px); -webkit-backdrop-filter: blur(5px); }

        /* Detail Elements */
        .detail-text { font-size: 0.9rem; line-height: 1.7; margin-bottom: 1.2rem; color: rgba(255,255,255,0.9); font-weight: 400; }
        .countdown-flex { display: flex; gap: 1.2rem; justify-content: center; margin-top: 1.5rem; }
        .cd-num { font-size: 2rem; line-height: 1; margin-bottom: 0.5rem; color: var(--light-lavender); }
        
        /* Interactive Card */
        .interactive-card { border: 1px solid rgba(255,255,255,0.4); background: rgba(255,255,255,0.1); padding: 1.5rem; margin-top: 1.5rem; cursor: pointer; text-align: left; color: var(--white); border-radius: 8px; }
        .interactive-content { display: none; padding-top: 1.2rem; margin-top: 1.2rem; border-top: 1px solid rgba(255,255,255,0.3); }
        .interactive-content.active { display: block; }
    </style>
</head>
<body>

    <div class="grain"></div>

    <!-- Hidden Audio Player -->
    <audio id="bgMusic" loop>
        <source src="song.mp3" type="audio/mpeg">
    </audio>

    <!-- 01 COVER SCREEN -->
    <section id="cover" class="screen active">
        <div class="bg-layer"></div>
        <div class="cover-overlay"></div>
        
        <div class="content-wrap" style="color: var(--white);">
            <h1 class="serif huge" style="margin-bottom: -0.5rem; text-shadow: 0 4px 20px rgba(0,0,0,0.7);">eighteen.</h1>
            <h2 class="script" style="color: var(--light-lavender); text-shadow: 0 4px 20px rgba(0,0,0,0.7);">Franz</h2>
            <p class="sans" style="margin-top: 2rem; margin-bottom: 1rem; letter-spacing: 0.1em; font-size: 0.8rem; text-transform: uppercase; text-shadow: 0 2px 10px rgba(0,0,0,0.7);">You are invited.</p>
            
            <!-- CHANGED: Now starts the music and enters the site -->
            <button class="btn-glass" onclick="enterAndPlay()">🎵 Play my favorite song</button>
        </div>
    </section>

    <!-- 02 WELCOME NOTE & MUSIC BUTTON -->
    <section id="welcome" class="screen">
        <div class="bg-layer"></div>
        <div class="overlay-60"></div>
        
        <div class="content-wrap content-box-light">
            <h2 class="script" style="color: var(--light-lavender); margin-bottom: 1.5rem;">Finally, 18! ✨</h2>
            
            <p class="sans detail-text">It feels crazy to think that 18 years have already passed. From little moments to big memories, every year has been part of the story that brought me here.</p>
            <p class="sans detail-text">Now, a new part of my story begins—and I’d love to celebrate it with you.</p>
            
            <!-- Music Player Button -->
            <button id="musicBtn" class="btn-glass btn-music" onclick="toggleMusic()">🎵 Play my favorite song</button>
            
            <p class="serif" style="font-size: 1.1rem; font-style: italic; color: var(--white); margin-top: 1.5rem; font-weight: bold;">Come celebrate, have fun,<br>and make a memory with me!</p>
            
            <button class="btn-glass btn-colored" style="margin-top: 1.5rem;" onclick="nav('menu')">Continue &rarr;</button>
        </div>
    </section>

    <!-- 03 MAIN MENU -->
    <section id="menu" class="screen">
        <div class="bg-layer"></div>
        <div class="overlay-60"></div>
        
        <div class="content-wrap content-box-light">
            <h2 class="serif" style="font-size: 2.2rem; color: var(--white);">eighteen.</h2>
            <h3 class="script" style="color: var(--light-lavender); margin-top: -8px;">Franz</h3>
            <p class="sans detail-text" style="margin-top: 0.5rem; font-size: 0.75rem; text-transform: uppercase; letter-spacing: 0.1em; margin-bottom: 0;">Explore the evening</p>
            
            <div class="menu-list">
                <button class="menu-item" onclick="nav('evening')">THE EVENING<span class="menu-sub">When & Where</span></button>
                <button class="menu-item" onclick="nav('dress-code')">DRESS CODE<span class="menu-sub">What to wear</span></button>
                <button class="menu-item" onclick="nav('roses')">18 ROSES<span class="menu-sub">Oh, this one's for you</span></button>
                <button class="menu-item" onclick="nav('countdown')">COUNTDOWN<span class="menu-sub">Until the night</span></button>
                <button class="menu-item" onclick="nav('rsvp')">RSVP<span class="menu-sub">Save your seat</span></button>
            </div>
        </div>
    </section>

    <!-- 04 THE EVENING -->
    <section id="evening" class="screen">
        <div class="bg-layer"></div>
        <div class="overlay-60"></div>
        <button class="back-btn" onclick="nav('menu')">&larr; Menu</button>
        
        <div class="content-wrap content-box-light">
            <p class="label">The Evening</p>
            <h2 class="serif" style="font-size: 2.2rem; margin-bottom: 1rem; color: var(--white);">September 27, 2026<br>6:00 PM</h2>
            <p class="sans detail-text">The Felicidad Mansion<br>#2 Baler Street corner Roosevelt Ave<br>San Francisco del Monte, Quezon City</p>
            <a href="https://www.google.com/maps/search/The+Felicidad+Mansion,+2+Baler+St,+Quezon+City/" target="_blank" class="btn-glass btn-colored">View Location &rarr;</a>
        </div>
    </section>

    <!-- 05 DRESS CODE -->
    <section id="dress-code" class="screen">
        <div class="bg-layer"></div>
        <div class="overlay-60"></div>
        <button class="back-btn" onclick="nav('menu')">&larr; Menu</button>

        <div class="content-wrap content-box-light">
            <p class="label">Dress Code</p>
            <h2 class="serif huge" style="margin-bottom: 0.5rem; color: var(--white);">WHITE.</h2>
            <p class="serif" style="font-size: 1.3rem; font-style: italic; margin-bottom: 1.5rem; color: var(--light-lavender);">Formal / Semi-formal</p>
            <p class="sans detail-text">Keep your main outfit white.<br>Pants, skirts, shoes and accessories may be any color.</p>
            <p class="sans" style="margin-top: 1.5rem; font-size: 0.75rem; color: rgba(255,255,255,0.7); font-weight: 500;">Please avoid purple, lavender and violet as the main outfit color.</p>
        </div>
    </section>

    <!-- 06 18 ROSES -->
    <section id="roses" class="screen">
        <div class="bg-layer"></div>
        <div class="overlay-60"></div>
        <button class="back-btn" onclick="nav('menu')">&larr; Menu</button>

        <div class="content-wrap content-box-dark">
            <h3 class="script" style="margin-bottom: 1rem; color: var(--light-lavender);">Oh, this one's for you.</h3>
            <p class="sans" style="font-size: 0.85rem; line-height: 1.6; margin-bottom: 1rem; color: var(--white);">You're part of my 18 Roses,<br>and I'm really happy you'll be<br>sharing this moment with me.</p>
            
            <div class="interactive-card" onclick="toggleCard()">
                <div style="display: flex; justify-content: space-between; align-items: center;">
                    <span class="serif" style="font-size: 1.1rem;">INSTRUCTIONS</span>
                    <span class="sans" style="font-size: 0.55rem; text-transform: uppercase; letter-spacing: 0.1em;">Tap to Open</span>
                </div>
                
                <div class="interactive-content" id="cardContent">
                    <div style="margin-bottom: 1.2rem;">
                        <p class="sans" style="margin-bottom: 0.2rem; color: var(--light-lavender); font-weight: 500; text-transform: uppercase; font-size: 0.7rem;">01 Pick a song</p>
                        <p class="sans" style="font-size: 0.8rem; color: var(--white);">One song that feels like us.</p>
                    </div>
                    
                    <div style="margin-bottom: 1.2rem;">
                        <p class="sans" style="margin-bottom: 0.2rem; color: var(--light-lavender); font-weight: 500; text-transform: uppercase; font-size: 0.7rem;">02 Tell me why</p>
                        <p class="sans" style="font-size: 0.8rem; color: var(--white);">2–3 natural sentences. Sweet, funny, nostalgic — anything goes.</p>
                    </div>

                    <div style="margin-bottom: 1.2rem;">
                        <p class="sans" style="margin-bottom: 0.2rem; color: var(--light-lavender); font-weight: 500; text-transform: uppercase; font-size: 0.7rem;">03 Send me:</p>
                        <p class="sans" style="font-size: 0.8rem; line-height: 1.6; color: var(--white);">Your name &middot; Song + Artist &middot; Why you chose it<br><br>Please send this to me via Messenger.</p>
                    </div>

                    <p class="serif" style="font-style: italic; font-size: 1rem; margin-top: 2rem; margin-bottom: 0.5rem; text-align: center; color: var(--white);">I'll hear your message while we dance. 🤍</p>
                </div>
            </div>
        </div>
    </section>

    <!-- 07 COUNTDOWN -->
    <section id="countdown" class="screen">
        <div class="bg-layer"></div>
        <div class="overlay-60"></div>
        <button class="back-btn" onclick="nav('menu')">&larr; Menu</button>

        <div class="content-wrap content-box-light">
            <p class="label">Until the Night</p>
            <div class="countdown-flex">
                <div><div class="serif cd-num" id="days">00</div><div class="sans" style="font-size: 0.65rem; text-transform: uppercase; letter-spacing: 0.1em; color: var(--white);">Days</div></div>
                <div><div class="serif cd-num" id="hours">00</div><div class="sans" style="font-size: 0.65rem; text-transform: uppercase; letter-spacing: 0.1em; color: var(--white);">Hours</div></div>
                <div><div class="serif cd-num" id="mins">00</div><div class="sans" style="font-size: 0.65rem; text-transform: uppercase; letter-spacing: 0.1em; color: var(--white);">Mins</div></div>
                <div><div class="serif cd-num" id="secs">00</div><div class="sans" style="font-size: 0.65rem; text-transform: uppercase; letter-spacing: 0.1em; color: var(--white);">Secs</div></div>
            </div>
        </div>
    </section>

    <!-- 08 RSVP -->
    <section id="rsvp" class="screen">
        <div class="bg-layer"></div>
        <div class="overlay-60"></div>
        <button class="back-btn" onclick="nav('menu')">&larr; Menu</button>

        <div class="content-wrap content-box-light">
            <h2 class="serif" style="font-size: 2.2rem; margin-bottom: 1rem; color: var(--white);">Will you be there?</h2>
            <p class="sans detail-text">Please confirm your attendance<br>by scanning below before Sept 10.</p>
            
            <img src="rsvp-qr.png" alt="Scan to RSVP" style="width: 140px; border-radius: 8px; box-shadow: 0 10px 30px rgba(0,0,0,0.3); margin-bottom: 2.5rem;">
            
            <h3 class="script" style="color: var(--light-lavender);">See you there.</h3>
            <p class="serif" style="font-size: 1.1rem; margin-top: 0.3rem; color: var(--white);">Franz</p>
        </div>
    </section>

    <script>
        function nav(targetId) {
            document.querySelectorAll('.screen').forEach(screen => {
                screen.classList.remove('active');
            });
            document.getElementById(targetId).scrollTo(0,0);
            document.getElementById(targetId).classList.add('active');
        }

        function toggleCard() {
            const content = document.getElementById('cardContent');
            content.classList.toggle('active');
        }

        // Music Play/Pause Logic
        let isPlaying = false;
        const bgMusic = document.getElementById('bgMusic');
        const musicBtn = document.getElementById('musicBtn');

        function toggleMusic() {
            if (isPlaying) {
                bgMusic.pause();
                musicBtn.innerHTML = "🎵 Play my favorite song";
            } else {
                bgMusic.play();
                musicBtn.innerHTML = "⏸ Pause song";
            }
            isPlaying = !isPlaying;
        }

        // New function to play music AND enter the site
        function enterAndPlay() {
            if (!isPlaying) {
                toggleMusic();
            }
            nav('welcome');
        }

        // Countdown Logic
        const targetDate = new Date('September 27, 2026 18:00:00').getTime();
        
        setInterval(() => {
            const now = new Date().getTime();
            const distance = targetDate - now;
            
            if (distance < 0) return;

            document.getElementById('days').innerText = String(Math.floor(distance / (1000 * 60 * 60 * 24))).padStart(2, '0');
            document.getElementById('hours').innerText = String(Math.floor((distance % (1000 * 60 * 60 * 24)) / (1000 * 60 * 60))).padStart(2, '0');
            document.getElementById('mins').innerText = String(Math.floor((distance % (1000 * 60 * 60)) / (1000 * 60))).padStart(2, '0');
            document.getElementById('secs').innerText = String(Math.floor((distance % (1000 * 60)) / 1000)).padStart(2, '0');
        }, 1000);
    </script>
</body>
</html>
